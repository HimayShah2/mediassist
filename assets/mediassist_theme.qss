/* Global Deep Dark Theme for MediAssist Pro */

/* Base Widget */
QWidget {
    background-color: #0f172a; /* Slate 900 */
    color: #f1f5f9; /* Slate 100 */
    font-family: "Inter", "Segoe UI", sans-serif;
}

/* Scroll Areas and Viewports - CRITICAL for fixing "white" backgrounds */
QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: #0f172a;
    border: none;
}
QAbstractScrollArea#scrollArea {
    background-color: #0f172a;
}
QWidget#scrollWidget {
    background-color: #0f172a;
}

/* Sidebar Styling */
QWidget#sidebar {
    background-color: #1e293b; /* Slate 800 */
    border-right: 1px solid #334155;
}

/* Headers */
QLabel#header_title {
    font-size: 28px; 
    font-weight: bold; 
    color: #38bdf8; /* Blue 400 */
    background: transparent;
}
QLabel#sub_header {
    font-size: 18px; 
    font-weight: bold; 
    color: #94a3b8; /* Slate 400 */
    background: transparent;
}

/* Push Buttons */
QPushButton {
    background-color: #3b82f6; /* Blue 500 */
    color: white;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: bold;
    border: none;
}
QPushButton:hover {
    background-color: #2563eb; /* Blue 600 */
}
QPushButton#action_primary {
    background-color: #0d9488; /* Teal 600 */
}
QPushButton#action_primary:hover {
    background-color: #0f766e;
}

/* Sidebar Buttons */
QPushButton.sidebar_btn {
    background-color: transparent;
    border: none;
    padding: 12px;
    text-align: left;
    font-size: 15px;
    border-radius: 6px;
    color: #94a3b8;
}
QPushButton.sidebar_btn:hover {
    background-color: #334155;
    color: #38bdf8;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTextEdit {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px;
    color: #f8fafc;
}

/* Tables & Lists */
QTableWidget, QListWidget, QListView, QTableView {
    background-color: #1e293b;
    border: 1px solid #334155;
    gridline-color: #334155;
    color: #f8fafc;
    alternate-background-color: #1e293b;
}
QHeaderView::section {
    background-color: #334155;
    color: #f8fafc;
    padding: 6px;
    border: 1px solid #1e293b;
    font-weight: bold;
}

/* Group Boxes */
QGroupBox {
    border: 2px solid #1e293b;
    border-radius: 8px;
    margin-top: 20px;
    font-weight: bold;
    color: #38bdf8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

/* Specialized Components */
QFrame#stat_card {
    background-color: #1e293b;
    border-radius: 10px;
    border: 1px solid #334155;
}
